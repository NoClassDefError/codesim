{
  "name": "codesim-frontend",
  "publisher": "hanchen-ge",
  "displayName": "Codesim System Viewer",
  "description": "Visualize CodeSim Python systems in a VS Code webview.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoClassDefError/codesim.git",
    "directory": "frontend"
  },
  "icon": "media/Icon.png",
  "license": "Apache-2.0",
  "version": "0.1.3",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:codesim-frontend.openViewer",
    "onCommand:codesim-frontend.openSignals",
    "onCommand:codesim-frontend.selectBackendDirectory",
    "onView:codesim-frontend.viewer"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codesim",
          "title": "codesim",
          "icon": "media/codesim.svg"
        }
      ]
    },
    "views": {
      "codesim": [
        {
          "id": "codesim-frontend.viewer",
          "name": "System Viewer",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codesim-frontend.openViewer",
        "title": "codesim: Open System Viewer"
      },
      {
        "command": "codesim-frontend.openSignals",
        "title": "codesim: Open Signals"
      },
      {
        "command": "codesim-frontend.selectBackendDirectory",
        "title": "CodeSim: Select Backend Directory"
      }
    ],
    "colors": [
      {
        "id": "codesim.backendRunningForeground",
        "description": "Foreground color of the CodeSim status-bar indicator while the Python backend is running.",
        "defaults": {
          "dark": "#73C991",
          "light": "#16825D",
          "highContrast": "#89D185",
          "highContrastLight": "#007F00"
        }
      }
    ],
    "configuration": {
      "title": "codesim",
      "properties": {
        "codesim-frontend.backendPath": {
          "type": "string",
          "default": "",
          "description": "Path containing the codesimpy package. Empty uses the current workspace or its codesim directory."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "npm run compile:extension && npm run build:webview",
    "compile:extension": "tsc -p ./",
    "build:webview": "tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.vite.json && vite build",
    "dev:webview": "vite",
    "build": "npm run compile",
    "package:vsix": "npm run build && npm run lint && vsce package --no-dependencies --allow-missing-repository --follow-symlinks",
    "watch": "npm run build:webview && tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src webview/src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "katex": "^0.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.140.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
